+
+
+def mark_stage(stage, domain='NONE'):
+    assert stage in STAGES and domain in DOMAINS
+    REPORT['diagnostic_stage'] = {'stage': stage, 'target_domain_class': domain,
+        'time_utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}
+
+
+def record_failure(exc):
+    info = {'category': 'UNKNOWN', 'time_utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}
+    if isinstance(exc, urllib.error.HTTPError):
+        info['category'] = 'HTTP_ERROR'
+        if isinstance(exc.code, int) and 100 <= exc.code <= 599:
+            info['http_status'] = exc.code
+    elif isinstance(exc, ssl.SSLError):
+        info['category'] = 'TLS_ERROR'
+    elif isinstance(exc, urllib.error.URLError):
+        info['category'] = 'TRANSPORT_ERROR'
+    elif isinstance(exc, subprocess.TimeoutExpired):
+        info['category'] = 'COMMAND_TIMEOUT'
+    elif isinstance(exc, AssertionError):
+        info['category'] = 'ASSERTION_REJECTED'
+    elif type(exc) is ValueError and len(exc.args) == 1 and isinstance(exc.args[0], str) and exc.args[0] in SAFE_REJECTIONS:
+        info['category'] = 'SAFETY_REJECTION'
+        info['reason_code'] = exc.args[0]
+    elif isinstance(exc, OSError):
+        info['category'] = 'FILESYSTEM_OR_PROCESS_ERROR'
+    elif isinstance(exc, RuntimeError):
+        info['category'] = 'CONTROLLED_STOP'
+    REPORT['diagnostic_failure'] = info
+
+
