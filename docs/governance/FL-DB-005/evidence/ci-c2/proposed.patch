+    assert pr['head']['repo']['full_name'] == 'xw564477242-cmyk/fastlik-backend'
+    assert pr['head']['ref'] == 'feature/FL-DB-005-tenant-identity-rls'
+    repo = Path(os.environ['GITHUB_WORKSPACE'])
+    head = run(['git', '-C', str(repo), 'rev-parse', 'HEAD']).strip()
+    assert head == pr['head']['sha'] and re.fullmatch('[0-9a-f]{40}', head)
+    REPORT['head'] = head
+    runid = os.environ['GITHUB_RUN_ID']; attempt = os.environ['GITHUB_RUN_ATTEMPT']
+    assert runid.isdigit() and attempt.isdigit()
+    PREFIX = f'fl-db005-ci-{runid}-{attempt}'
+    SESSION = secrets.token_hex(16)
