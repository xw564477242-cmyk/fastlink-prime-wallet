+        assert not rel.is_absolute() and '..' not in rel.parts
+        if rel.name.startswith('.env') or rel.name == '.npmrc':
+            continue
+        original = repo/rel
+        assert original.is_file() and not original.is_symlink()
+        target = TASK/'backend'/rel; target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(original, target)
+    for n in ['package.json', 'package-lock.json', 'prisma/schema.prisma']:
+        target = TASK/'prepare'/n; target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(repo/n, target)
+    # Network preparation precedes generation of any DB credentials or fixtures.
+    for image in [PG, NODE]:
+        run(['docker', 'pull', '--platform', 'linux/amd64', image])
+        assert image in json.loads(run(['docker', 'image', 'inspect', image]))[0]['RepoDigests']
