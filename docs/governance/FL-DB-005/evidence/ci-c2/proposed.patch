+    REPORT['images'] = {'postgres': PG, 'node': NODE}
+    # Copy tracked source only; never copy any .env, .npmrc, Git metadata or runner credentials.
+    paths = run(['git', '-C', str(repo), 'ls-files', '-z']).split('\0')
+    for name in filter(None, paths):
