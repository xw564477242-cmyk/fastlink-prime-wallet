+        "function scan(d){for(const x of fs.readdirSync(d,{withFileTypes:true})){"
+        "if(x.name.startsWith('.'))continue;const p=path.join(d,x.name);"
+        "if(x.name.startsWith('@')){scan(p);continue;}"
