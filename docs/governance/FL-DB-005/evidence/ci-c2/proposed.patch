+
+PG = 'postgres@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24'
+NODE = 'node@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d'
+HERE = Path(__file__).resolve().parent
+REPORT = {'status': 'BLOCKED', 'checks': {}, 'limits': ['historical dependency audit reused offline; no fresh audit','isolation prototype only',
+    'not actual Prisma/JWT/task integration', 'legacy full CI remains skipped while Draft',
+    'two existing conditional DB Jest tests remain skipped', 'no funds prerequisite release']}
+TASK = None
+PREFIX = None
+SESSION = None
+SECRET_VALUES = []
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def run(argv, *, data=None, timeout=600, env=None):
+    p = subprocess.run(argv, input=data, capture_output=True, text=True,
+                       timeout=timeout, env=env)
+    if p.returncode:
+        # No captured stdout, stderr, command arguments, exception strings or SQL in logs.
+        raise RuntimeError('subprocess_failed')
+    return p.stdout
+
+
+def node(name, network, work, command, auth=False):
+    argv = ['docker', 'run', '--name', PREFIX+'-'+name, '--platform', 'linux/amd64',
+            '--label', 'fl-db005.ci-session='+SESSION, '--network', network, '--user', f'{os.getuid()}:{os.getgid()}',
+            '--cap-drop', 'ALL', '--security-opt', 'no-new-privileges', '--memory', '4g',
+            '--cpus', '2', '--pids-limit', '512', '--workdir', '/work',
+            '--mount', f'type=bind,src={work},dst=/work',
+            '--mount', f'type=bind,src={TASK}/modules,dst=/work/node_modules',
+            '--mount', f'type=bind,src={HERE},dst=/runner,readonly',
+            '--mount', f'type=bind,src={TASK}/results,dst=/results',
+            '-e', 'HOME=/tmp', '-e', 'NPM_CONFIG_USERCONFIG=/dev/null',
+            '-e', 'NPM_CONFIG_GLOBALCONFIG=/dev/null', '-e', 'NPM_CONFIG_AUDIT=false',
+            '-e', 'NPM_CONFIG_FUND=false', '-e', 'PRISMA_HIDE_UPDATE_MESSAGE=true', '-e', 'CHECKPOINT_DISABLE=1',
+
+            '-e', 'NODE_ENV=test', '-e', 'CI=true', '-e', 'DB5_RUN_PREFIX='+PREFIX]
+    argv += ['--mount', f'type=bind,src={TASK}/downloads,dst=/downloads,readonly',
+             '--mount', f'type=bind,src={TASK}/npm-cache,dst=/npm-cache',
+             '--mount', f'type=bind,src={TASK}/engines,dst=/engines,readonly',
+             '-e', 'PRISMA_QUERY_ENGINE_LIBRARY=/engines/libquery-engine',
+             '-e', 'PRISMA_SCHEMA_ENGINE_BINARY=/engines/schema-engine',
+             '-e', 'PRISMA_GENERATE_SKIP_AUTOINSTALL=1', '-e', 'NPM_CONFIG_OFFLINE=true',
+             '-e', 'NPM_CONFIG_IGNORE_SCRIPTS=true', '-e', 'NPM_CONFIG_CACHE=/npm-cache']
+    if auth:
+        for i in [3, 4]:
+            argv += ['--mount', f'type=bind,src={TASK}/private/r{i},dst=/auth/r{i},readonly']
+    # DATABASE_URL / DIRECT_URL / JWT / cloud credentials / GITHUB_TOKEN are not forwarded.
+    argv += [NODE] + command
+    return run(argv, timeout=1800)
+
+
+def validate_inputs(repo):
+    m = json.loads((HERE/'inputs.json').read_text())
+    assert digest(repo/'package-lock.json') == m['lock_sha256']
+    assert digest(repo/'package.json') == m['package_sha256']
+    assert digest(repo/'prisma/schema.prisma') == m['schema_sha256']
+    assert len(m['original']) == 32 and len(m['candidate']) == 3
+    assert [r['order'] for r in m['original']] == list(range(1, 33))
+    for row in m['original'] + m['candidate']:
+        assert row['path'].startswith('prisma/migrations/')
+        assert '..' not in Path(row['path']).parts
+        assert digest(repo/row['path']) == row['sha256']
