--- /dev/null
+++ b/scripts/fl-db005-ci/negative-final-r3-r4.cjs
@@ -0,0 +1,180 @@
+const fs = require("node:fs"),
+  crypto = require("node:crypto");
+const { PrismaClient } = require("/work/node_modules/@prisma/client");
+const output = { rounds: [], scope: "isolated identity and least-privilege controls" };
+const clients = [];
+const save = () =>
+  fs.writeFileSync("/results/negative-final-r3-r4.json", JSON.stringify(output, null, 2));
+function make(c, r) {
+  const u = new URL(`postgresql://${c.container}:5432/${c.database}`);
+  u.username = r;
+  u.password = r === "db5_initializer" ? c.initializer : c.roles[r];
+  u.searchParams.set("connection_limit", "2");
+  const p = new PrismaClient({
+    datasources: { db: { url: u.toString() } },
+    log: [],
+    errorFormat: "minimal",
+  });
+  clients.push(p);
+  return p;
+}
+const code = (e) => e.meta?.code || e.code || "UNKNOWN";
+(async () => {
+  for (const round of [3, 4]) {
+    const c = JSON.parse(fs.readFileSync(`/auth/r${round}/credentials.json`));
+    if (c.container !== `${process.env.DB5_RUN_PREFIX}-r${round}` || c.database !== `fl_db005_r${round}`) throw new Error("invalid target");
+    const pool = make(c, "db5_pool"),
+      issuer = make(c, "db5_issuer"),
+      owner = make(c, "db5_initializer"),
+      ordinary = make(c, "db5_user_a");
+    const r = { round, cases: [] };
+    output.rounds.push(r);
+    const add = (name, ok, details = {}) => {
+      r.cases.push({ name, status: ok ? "PASS" : "FAIL", ...details });
+      save();
+    };
+    async function denied(name, fn) {
+      try {
+        await fn();
+        add(name, false);
+        throw new Error("CONTROL_STOP");
+      } catch (e) {
+        if (e.message === "CONTROL_STOP") throw e;
+        add(name, code(e) === "42501", { sqlstate: code(e) });
+        if (code(e) !== "42501") throw new Error("CONTROL_STOP");
+      }
+    }
+    async function issue(tx, seconds = 30) {
+      const [t] =
+        await tx.$queryRaw`SELECT session_user::text AS login,pg_backend_pid() AS pid,pg_current_xact_id()::text AS xid`;
+      const value = crypto.randomBytes(32).toString("hex"),
+        digest = crypto.createHash("sha256").update(value).digest("hex");
+      await issuer.$queryRaw`SELECT fl_identity.issue_ticket(decode(${digest},'hex'),'pool_a',${t.login}::name,${t.pid}::int,${t.xid}::xid8,'address-book',clock_timestamp()+${seconds}::int*interval '1 second')::text`;
+      return value;
+    }
+    await denied(
+      "runtime_cannot_read_mapping",
+      () => pool.$queryRaw`SELECT principal_id FROM fl_identity.principal`,
+    );
+    await denied(
+      "runtime_cannot_read_ticket_digests",
+      () => pool.$queryRaw`SELECT digest FROM fl_identity.ticket`,
+    );
+    await denied("runtime_cannot_set_identity_owner", () =>
+      pool.$executeRawUnsafe("SET ROLE fl_db005_identity_owner"),
+    );
+    await denied(
+      "runtime_cannot_issue",
+      () =>
+        pool.$queryRaw`SELECT fl_identity.issue_ticket(decode(repeat('0',64),'hex'),'pool_a','db5_pool'::name,1,'1'::xid8,'address-book',clock_timestamp()+interval '20 seconds')::text`,
+    );
+    await denied(
+      "customer_insert_denied",
+      () =>
+        ordinary.$executeRaw`INSERT INTO public."Customer" (id) VALUES ('synthetic-disallowed')`,
+    );
+    await denied(
+      "customer_update_denied",
+      () =>
+        ordinary.$executeRaw`UPDATE public."Customer" SET "firstName"='synthetic' WHERE id='db5_customer_a'`,
+    );
+    await denied(
+      "customer_delete_denied",
+      () => ordinary.$executeRaw`DELETE FROM public."Customer" WHERE id='db5_customer_a'`,
+    );
+    await denied("purpose_conflict_denied", () =>
+      pool.$transaction(async (tx) => {
+        const v = await issue(tx);
+        await tx.$queryRaw`SELECT fl_identity.bind_ticket(${v},'wrong-purpose')::text`;
+      }),
+    );
+    await denied(
+      "random_ticket_denied",
+      () =>
+        pool.$queryRaw`SELECT fl_identity.bind_ticket(${crypto.randomBytes(32).toString("hex")},'address-book')::text`,
+    );
+    await denied("wrong_login_pid_denied", () =>
+      pool.$transaction(async (tx) => {
+        const v = await issue(tx);
+        await ordinary.$queryRaw`SELECT fl_identity.bind_ticket(${v},'address-book')::text`;
+      }),
+    );
+    await denied("expiry_denied", () =>
+      pool.$transaction(async (tx) => {
+        const v = await issue(tx, 1);
+        await tx.$executeRaw`SELECT pg_sleep(1.1)`;
+        await tx.$queryRaw`SELECT fl_identity.bind_ticket(${v},'address-book')::text`;
+      }),
+    );
+    await denied("same_transaction_duplicate_denied", () =>
+      pool.$transaction(async (tx) => {
+        const v = await issue(tx);
+        await tx.$queryRaw`SELECT fl_identity.bind_ticket(${v},'address-book')::text`;
+        await tx.$queryRaw`SELECT fl_identity.bind_ticket(${v},'address-book')::text`;
+      }),
+    );
+    let old;
+    await pool.$transaction(async (tx) => {
+      old = await issue(tx);
+      await tx.$queryRaw`SELECT fl_identity.bind_ticket(${old},'address-book')::text`;
+    });
+    await denied(
+      "new_transaction_after_commit_replay_denied",
+      () => pool.$queryRaw`SELECT fl_identity.bind_ticket(${old},'address-book')::text`,
+    );
+    try {
+      await pool.$transaction(async (tx) => {
+        old = await issue(tx);
+        await tx.$queryRaw`SELECT fl_identity.bind_ticket(${old},'address-book')::text`;
+        throw new Error("SYNTHETIC_ROLLBACK");
+      });
+    } catch (e) {
+      if (e.message !== "SYNTHETIC_ROLLBACK") throw e;
+    }
+    await denied(
+      "new_transaction_after_rollback_replay_denied",
+      () => pool.$queryRaw`SELECT fl_identity.bind_ticket(${old},'address-book')::text`,
+    );
+    const unbound = await pool.$queryRaw`SELECT count(*)::int AS n FROM public."Customer"`;
+    add("rollback_pool_context_absent", unbound[0].n === 0);
+    const seq = await owner.$queryRawUnsafe(
+      "SELECT count(*)::int AS n FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='fl_identity' AND c.relkind='S' AND (has_sequence_privilege('fl_db005_runtime',c.oid,'USAGE') OR has_sequence_privilege('fl_db005_runtime',c.oid,'SELECT') OR has_sequence_privilege('fl_db005_runtime',c.oid,'UPDATE') OR has_sequence_privilege('fl_db005_issuer',c.oid,'USAGE') OR EXISTS(SELECT 1 FROM aclexplode(coalesce(c.relacl,acldefault('S',c.relowner))) a WHERE a.grantee=0))",
+    );
+    add("private_sequence_no_runtime_issuer_public_rights", seq[0].n === 0);
+    r.default_privileges = await owner.$queryRawUnsafe(
+      "SELECT pg_get_userbyid(defaclrole) AS creator,defaclnamespace::regnamespace::text AS namespace,defaclobjtype,defaclacl::text AS acl FROM pg_default_acl ORDER BY 1,2,3",
+    );
+    r.table_grants = await owner.$queryRawUnsafe(
+      "SELECT table_name,privilege_type FROM information_schema.table_privileges WHERE grantee='fl_db005_runtime' ORDER BY table_name,privilege_type",
+    );
+    add(
+      "runtime_positive_grants_only_two_objects",
+      r.table_grants.length === 5 &&
+        r.table_grants.every((x) => ["Customer", "WithdrawalAddress"].includes(x.table_name)),
+    );
+    r.sequence_count = (
+      await owner.$queryRawUnsafe(
+        "SELECT count(*)::int AS n FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='fl_identity' AND c.relkind='S'",
+      )
+    )[0].n;
+    r.lifecycle = "LIMITED: retained; no automatic cleanup; isolation prototype only";
+    save();
+  }
+})()
+  .catch((e) => {
+    output.error = { code: code(e), category: e.constructor.name };
+    save();
+    process.exitCode = 1;
+  })
+  .finally(async () => {
+    await Promise.all(clients.map((c) => c.$disconnect().catch(() => {})));
+    console.log(
+      JSON.stringify(
+        output.rounds.map((r) => ({
+          round: r.round,
+          pass: r.cases.filter((x) => x.status === "PASS").length,
+          fail: r.cases.filter((x) => x.status === "FAIL").length,
+        })),
+      ),
+    );
+  });
diff --git a/scripts/fl-db005-ci/prepare_downloads.py b/scripts/fl-db005-ci/prepare_downloads.py
new file mode 100644
--- /dev/null
+++ b/scripts/fl-db005-ci/prepare_downloads.py
@@ -0,0 +1,121 @@
+"""HTTPS GET of fixed package/engine bytes only; never sends audit data or credentials."""
+import base64
+import gzip
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import ssl
+import urllib.parse
+import urllib.request
+
+MAX_FILE = 128 * 1024 * 1024
+MAX_TOTAL = 2 * 1024 * 1024 * 1024
+MAX_ENGINE = 256 * 1024 * 1024
+
+
+def check_url(url, allowed_urls):
+    u = urllib.parse.urlsplit(url)
+    if (url not in allowed_urls or u.scheme != 'https' or u.username is not None
+            or u.password is not None or u.port not in (None, 443) or u.query or u.fragment
+            or u.hostname not in {'registry.npmjs.org', 'binaries.prisma.sh'}):
+        raise ValueError('unapproved_download_target')
+    # Narrower than domain allowlist: only exact reviewed package or engine file URLs.
+    if u.hostname == 'registry.npmjs.org' and ('/-/' not in u.path or not u.path.endswith('.tgz')):
+        raise ValueError('not_package_tarball')
+    if u.hostname == 'binaries.prisma.sh' and not u.path.startswith('/all_commits/'):
+        raise ValueError('not_pinned_engine')
+
+
+class CheckedRedirect(urllib.request.HTTPRedirectHandler):
+    def __init__(self, allowed_urls):
+        self.allowed_urls = allowed_urls
+
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        check_url(newurl, self.allowed_urls)
+        if req.get_method() != 'GET':
+            raise ValueError('non_get_denied')
+        return super().redirect_request(req, fp, code, msg, headers, newurl)
+
+
+def verify_sri(raw, integrity):
+    tokens = integrity.split()
+    parsed = []
+    for token in tokens:
+        algorithm, encoded = token.split('-', 1)
+        if algorithm not in {'sha256', 'sha384', 'sha512'}:
+            raise ValueError('unsupported_integrity')
+        parsed.append((algorithm, base64.b64decode(encoded, validate=True)))
+    if not parsed or not all(hashlib.new(a, raw).digest() == expected for a, expected in parsed):
+        raise ValueError('integrity_mismatch')
+
+
+def main(task_root, source):
+    task_root, source = Path(task_root), Path(source)
+    # No ambient proxy or registry authentication is accepted.
+    if any(v for k, v in os.environ.items() if k.lower() in {
+        'http_proxy', 'https_proxy', 'all_proxy', 'npm_token', 'node_auth_token',
+        'npm_config_proxy', 'npm_config_https_proxy'}):
+        raise ValueError('ambient_proxy_or_auth_denied')
+    if (task_root/'private').exists() and any((task_root/'private').iterdir()):
+        raise ValueError('authentication_already_exists')
+    manifest = json.loads((source/'inputs.json').read_text())
+    lock_path = task_root/'prepare/package-lock.json'
+    if hashlib.sha256(lock_path.read_bytes()).hexdigest() != manifest['lock_sha256']:
+        raise ValueError('lock_hash_changed')
+    packages = {}
+    for path, row in json.loads(lock_path.read_text())['packages'].items():
+        if not path:
+            continue
+        url, integrity = row['resolved'], row['integrity']
+        if url in packages and packages[url] != integrity:
+            raise ValueError('inconsistent_lock_integrity')
+        packages[url] = integrity
+    allowed = set(packages) | {x['url'] for x in manifest['engines']}
+    for url in allowed:
+        check_url(url, allowed)
+    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}),
+        CheckedRedirect(allowed), urllib.request.HTTPSHandler(context=ssl.create_default_context()))
+    total = 0
+
+    def fetch(url):
+        nonlocal total
+        check_url(url, allowed)
+        if shutil.disk_usage(task_root).free < 6 * 1024**3:
+            raise ValueError('insufficient_disk')
+        req = urllib.request.Request(url, method='GET', headers={'Accept': 'application/octet-stream'})
+        with opener.open(req, timeout=45) as response:
+            check_url(response.url, allowed)
+            if response.status != 200:
+                raise ValueError('http_not_200')
+            # 401/407 also fail in urllib; no auth handler, netrc, cookies or retry credentials.
+            raw = response.read(MAX_FILE + 1)
+        if len(raw) > MAX_FILE:
+            raise ValueError('download_size_limit')
+        total += len(raw)
+        if total > MAX_TOTAL:
+            raise ValueError('total_size_limit')
+        return raw
+
+    downloads = task_root/'downloads'; downloads.mkdir(mode=0o700)
+    cache = task_root/'npm-cache'; cache.mkdir(mode=0o700)
+    engines = task_root/'engines'; engines.mkdir(mode=0o700)
+    for index, (url, integrity) in enumerate(sorted(packages.items())):
+        raw = fetch(url); verify_sri(raw, integrity)
+        (downloads/f'{index:04d}.tgz').write_bytes(raw)
+    for engine in manifest['engines']:
+        raw = fetch(engine['url'])
+        if hashlib.sha256(raw).hexdigest() != engine['gzip_sha256']:
+            raise ValueError('engine_gzip_hash_mismatch')
+        with gzip.GzipFile(fileobj=io.BytesIO(raw)) as stream:
+            content = stream.read(MAX_ENGINE + 1)
+        if len(content) > MAX_ENGINE or hashlib.sha256(content).hexdigest() != engine['sha256']:
+            raise ValueError('engine_hash_mismatch')
+        if engine['file'] not in {'libquery-engine', 'schema-engine'}:
+            raise ValueError('engine_filename_denied')
+        dest = engines/engine['file']; dest.write_bytes(content); dest.chmod(0o700)
+    return {'packages': len(packages), 'engines': 2, 'audit_requests': 0,
+            'verified_bytes': total, 'redirects': 'exact reviewed URLs only'}
