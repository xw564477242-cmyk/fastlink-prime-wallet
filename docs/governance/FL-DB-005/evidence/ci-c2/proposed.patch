+        "const j=JSON.parse(fs.readFileSync(f));out.push({name:j.name,version:j.version});"
+        "const n=path.join(p,'node_modules');if(fs.existsSync(n))scan(n);}}"
+        "scan('/work/node_modules');console.log(JSON.stringify(out));"]))
+    installed = {(p['name'], p['version']) for p in inventory}
+    pairs = {(p['name'], p['version']) for p in approved['packages']}
+    assert len(pairs) == 172 and len({name for name, _ in pairs}) == 165 and pairs <= installed
+    packages = {}
