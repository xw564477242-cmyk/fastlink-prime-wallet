+++ b/.github/workflows/fl-db005-isolated-review.yml
@@ -0,0 +1,68 @@
+name: DB5等价隔离检查 (Draft only)
+on:
+  pull_request:
+    branches: [dev]
+    types: [opened, reopened, synchronize]
+permissions:
+  contents: read
+  pull-requests: read
+concurrency:
+  group: db5-isolated-${{ github.event.pull_request.number }}
+  cancel-in-progress: false
+jobs:
+  db5-isolated-review:
+    if: >-
+      github.event.pull_request.number == 336 &&
+      github.event.pull_request.draft == true &&
+      github.event.pull_request.head.repo.full_name == github.repository &&
+      github.event.pull_request.head.ref == 'feature/FL-DB-005-tenant-identity-rls'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          persist-credentials: false
+          fetch-depth: 1
+      - name: Confirm Draft, exact event HEAD, dev and auto-merge disabled
+        env:
+          GH_TOKEN: ${{ github.token }}
+          EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
+        run: |
+          gh api repos/xw564477242-cmyk/fastlik-backend/pulls/336 \
+            --jq '{draft, head: .head.sha, base: .base.ref, auto_merge, state}' \
+            > "$RUNNER_TEMP/db5-pr-before.json"
+          python3 - <<'PY'
+          import json,os
+          from pathlib import Path
+          p=json.loads((Path(os.environ['RUNNER_TEMP'])/'db5-pr-before.json').read_text())
+          assert p['draft'] and p['state']=='open' and p['auto_merge'] is None
+          assert p['head']==os.environ['EXPECTED_HEAD'] and p['base']=='dev'
+          PY
+      - name: DB5等价隔离检查：Jest build lint and offline prior-audit verification
+        run: python3 scripts/fl-db005-ci/run.py
+      - name: Recheck unchanged PR boundary
+        if: ${{ always() && !cancelled() }}
+        env:
+          GH_TOKEN: ${{ github.token }}
+          EXPECTED_HEAD: ${{ github.event.pull_request.head.sha }}
+        run: |
+          gh api repos/xw564477242-cmyk/fastlik-backend/pulls/336 \
+            --jq '{draft, head: .head.sha, base: .base.ref, auto_merge, state}' \
+            > "$RUNNER_TEMP/db5-pr-after.json"
+          python3 - <<'PY'
+          import json,os
+          from pathlib import Path
+          p=json.loads((Path(os.environ['RUNNER_TEMP'])/'db5-pr-after.json').read_text())
+          assert p['draft'] and p['state']=='open' and p['auto_merge'] is None
+          assert p['head']==os.environ['EXPECTED_HEAD'] and p['base']=='dev'
+          PY
+      - name: Upload only constructed nonsecret summary
+        if: ${{ always() && !cancelled() }}
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: db5-summary-${{ github.event.pull_request.head.sha }}-${{ github.run_id }}
+          path: ${{ runner.temp }}/db5-public-summary.json
+          if-no-files-found: error
+          retention-days: 7
+          include-hidden-files: false
