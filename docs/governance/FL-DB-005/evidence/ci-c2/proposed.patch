+    matching = json.loads(node('audit-match', 'none', TASK/'backend', ['node', '-e',
+        "const fs=require('fs'),semver=require('/work/node_modules/semver');"
+        "const c=JSON.parse(fs.readFileSync('/results/audit-candidates.json'));"
+        "if(c.some(x=>!semver.validRange(x.range)))process.exit(2);"
+        "console.log(JSON.stringify(c.filter(x=>semver.satisfies(x.version,x.range))"
+        ".map(x=>x.severity))); "]))
+    assert matching == ['moderate'] * 4
+    REPORT['audit'] = {'mode': 'REUSED_OFFLINE_NOT_FRESH_AUDIT', 'network_requests': 0,
+        'approved_source_sha256': digest(src), 'evidence_sha256': digest(evidence),
+        'prior_audit_time': prior['time_utc'], 'prior_http_status': 200,
+        'endpoint_class': 'official npm Bulk (historical only)',
+        'wire_sha256': prior['wire_sha256'], 'source_records': 174, 'unique_pairs': 172, 'package_names': 165,
+        'matching_severity_counts': {'moderate': 4, 'high': 0, 'critical': 0},
+        'response_summary': 'four retained matching advisories; not raw-response hash',
+        'limit': 'No new advisories fetched; unchanged approved dependency snapshot only.'}
+    REPORT['checks']['prior_audit_offline_linkage'] = 'PASS_WITH_FOUR_MODERATE'
+
+
+def stop():
+    if not PREFIX:
+        return
+    # Only this invocation's exact named containers. No rm, volume/network deletion or prune.
+    names = [PREFIX+'-'+n for n in ['install', 'build', 'lint', 'jest', 'targeted',
+        'inventory', 'audit-match', 'r3', 'r4', 'dynamic', 'negative']]
+    for name in names:
+        inspected = subprocess.run(['docker', 'inspect', name], capture_output=True, text=True, timeout=10)
+        if inspected.returncode:
+            if 'No such object' in inspected.stderr or 'No such container' in inspected.stderr:
+                continue
+            raise RuntimeError('container_state_unverified')
+        labels = json.loads(inspected.stdout)[0]['Config'].get('Labels') or {}
+        if labels.get('fl-db005.ci-session') != SESSION:
+            continue
