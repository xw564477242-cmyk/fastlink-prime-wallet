  "runtime": {
    "assets": {
      "headers": {
        "version": 2,
        "rules": {
          "/assets/*": {
            "set": {
              "cache-control": "public, max-age=31536000, immutable"
            },
            "unset": []
          }
        }
      },
      "raw_headers": "/assets/*\n  cache-control: public, max-age=31536000, immutable",
      "serve_directly": false,
      "raw_run_worker_first": true,
      "base_path": "/"
    },
    "compatibility_date": "2026-07-25",
