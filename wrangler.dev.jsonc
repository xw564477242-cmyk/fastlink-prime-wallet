{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fastlink-prime-wallet-dev",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.mjs",
        "**/*.js"
      ]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "vars": {
    "FASTLINK_BACKEND_ORIGIN": "https://fastlink-backend-dev-development-a.up.railway.app",
    "FASTLINK_PROXY_ID": "prime-dev"
  },
  "observability": {
    "enabled": true
  }
}
